# WireGuard Configuration
# Copy this file to .env and configure your settings

# Select profile to run (server|client)
PROFILE=server

# -------- Client (PROFILE=client) --------
# Required
CLIENT_IP=10.0.2.2/32
CLIENT_SUBNET=10.0.2.0/24
CLIENT_ENDPOINT=your-server.com
CLIENT_PORT=51821
SERVER_PUBLIC_KEY=
ALLOWEDIPS=0.0.0.0/0,::0 # use 10.0.2.0/24 if you only want to route VPN traffic through tunnel

# Optional
CLIENT_DNS=1.1.1.1
# Optional server preshared key used by the client when connecting
SERVER_PRESHARED_KEY=
# Optional client private key If set, container will use this; otherwise it generates.
CLIENT_PRIVATE_KEY=
# Optional client public key If set, container will use this; otherwise it generates.
CLIENT_PUBLIC_KEY=
# Optional: ip:port to expose through the tunnel (this host only applies its own IP)
VPN_ALLOW=10.0.2.2:22,10.0.2.2:3060
# When the client container stops, allow SSH from CLIENT_ENDPOINT (public server IP)
ENABLE_EMERGENCY_ACCESS=true

# -------- MinIO Configuration (PROFILE=client) --------
# Set to false to skip MinIO setup and related script checks
ENABLE_MINIO=false
# MinIO root credentials (used for initial admin login)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=miniopassword
# MinIO listen ports (compose only, not firewall)
MINIO_WEB_PORT=8080
MINIO_CONSOLE_PORT=4020
# Comma-separated list of buckets to create (will be set to public read access)
MINIO_PUBLIC_BUCKETS=public

# -------- Server (PROFILE=server) --------
# Required
# Peer 1
PEER1_PUBLIC_KEY=
PEER1_ALLOWED_IPS=10.0.2.2/32
# Optional preshared key; leave blank or remove to disable
PEER1_PRESHARED_KEY=

# Peer 2
PEER2_PUBLIC_KEY=
PEER2_ALLOWED_IPS=10.0.2.3/32
# Optional preshared key; leave blank or remove to disable
PEER2_PRESHARED_KEY=

# Optional server keypair. If set, container will use these; otherwise it generates.
SERVER_PRIVATE_KEY=
SERVER_PUBLIC_KEY=
# Optional: ip:port map. This host's IP is DNATed to the host; other IPs are peer forwards
VPN_ALLOW=10.0.2.1:22,10.0.2.2:22,10.0.2.3:22,10.0.2.3:3060